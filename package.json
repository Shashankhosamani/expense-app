{
  "name": "costiq",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:web": "pnpm --filter @costiq/web dev",
    "dev:worker": "pnpm --filter @costiq/worker dev",
    "web": "pnpm --filter @costiq/web dev",
    "worker": "pnpm --filter @costiq/worker dev",
    "build": "pnpm -r build",
