<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest merge. Adds cleartext HTTP for the local worker dev
  server (`pnpm worker`, plain http:// on :8787) without weakening the
  release build, which stays HTTPS-only with no cleartext exception.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig"
        xmlns:tools="http://schemas.android.com/tools" />

</manifest>
